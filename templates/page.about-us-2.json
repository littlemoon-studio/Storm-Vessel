    "custom_liquid_Hai3Df": {
      "type": "custom-liquid",
      "custom_css": [],
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<style>\n  .scf-outer {\n    overflow: hidden;\n    width: 100%;\n  }\n\n  .scf-wrap {\n    background: #F9F5EE;\n    padding: 48px 0 80px 0;\n    overflow: visible;\n    user-select: none;\n    position: relative;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 160vw;\n  }\n\n  .scf-stage {\n    width: 100%;\n    height: 520px;\n    position: relative;\n    perspective: 1200px;\n  }\n\n  .scf-slide {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    width: 312px;\n    height: 416px;\n    margin-top: -208px;\n    margin-left: -156px;\n    transition: transform 0.5s cubic-bezier(0.25, 0.1, 0.25, 1),\n                opacity   0.5s cubic-bezier(0.25, 0.1, 0.25, 1);\n    transform-style: preserve-3d;\n    cursor: default;\n  }\n\n  .scf-img-wrap {\n    width: 100%;\n    height: 100%;\n    overflow: hidden;\n  }\n\n  .scf-img-wrap img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n    pointer-events: none;\n  }\n\n  .scf-caption {\n    position: absolute;\n    bottom: -32px;\n    left: 50%;\n    transform: translateX(-50%);\n    white-space: nowrap;\n    font-size: 11px;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    color: #000;\n    opacity: 0;\n    transition: opacity 0.4s ease;\n    pointer-events: none;\n  }\n\n  .scf-slide.is-active .scf-caption {\n    opacity: 1;\n  }\n\n  .scf-lightbox {\n    position: fixed;\n    inset: 0;\n    background: rgba(0,0,0,0.92);\n    z-index: 10000;\n    display: none;\n    place-items: center;\n  }\n\n  .scf-lightbox.active { display: grid; }\n\n  .scf-lightbox img {\n    max-width: 90vw;\n    max-height: 90vh;\n    object-fit: contain;\n  }\n\n  .scf-lb-close {\n    position: absolute;\n    top: 20px;\n    right: 24px;\n    color: #fff;\n    font-size: 36px;\n    background: none;\n    border: none;\n    cursor: pointer;\n    line-height: 1;\n    padding: 0;\n  }\n</style>\n\n<div class=\"scf-outer\">\n  <div class=\"scf-wrap\">\n    <div class=\"scf-stage\" id=\"scf-stage\">\n\n      <div class=\"scf-slide\" data-full=\"https://cdn.shopify.com/s/files/1/0447/1017/files/Storm_Surf_Shop_Polaroid.png?v=1776623662\">\n        <div class=\"scf-img-wrap\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0447/1017/files/DSC05395.jpg?v=1776711774\" alt=\"Photo 1\">\n        </div>\n        <div class=\"scf-caption\">Original shop - Laundromat days. 1998</div>\n      </div>\n\n      <div class=\"scf-slide\" data-full=\"https://cdn.shopify.com/s/files/1/0447/1017/files/Storm_Surf_Shop_Polaroid.png?v=1776623662\">\n        <div class=\"scf-img-wrap\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0447/1017/files/DSC05337.png?v=1776711483\" alt=\"Photo 2\">\n        </div>\n        <div class=\"scf-caption\">A frosted tipped Allister Fernie</div>\n      </div>\n\n      <div class=\"scf-slide\" data-full=\"https://cdn.shopify.com/s/files/1/0447/1017/files/Storm_Surf_Shop_Polaroid.png?v=1776623662\">\n        <div class=\"scf-img-wrap\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0447/1017/files/DSC05602.png?v=1776712210\" alt=\"Photo 3\">\n        </div>\n        <div class=\"scf-caption\">1998.</div>\n      </div>\n\n      <div class=\"scf-slide\" data-full=\"https://cdn.shopify.com/s/files/1/0447/1017/files/DSC05321.jpg?v=1776711470\">\n        <div class=\"scf-img-wrap\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0447/1017/files/DSC05321.jpg?v=1776711470\" alt=\"Photo 4\">\n        </div>\n        <div class=\"scf-caption\">A youn Pete Devries, one of Storm's original employees.</div>\n      </div>\n\n      \n<div class=\"scf-slide\" data-full=\"YOUR_FULL_SIZE_URL\">\n  <div class=\"scf-img-wrap\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0447/1017/files/DSC08748.png?v=1776711484\" alt=\"Photo 6\">\n  </div>\n  <div class=\"scf-caption\">A quick hop across the street, our new home on 444 Campbell St.</div>\n</div>\n\n<div class=\"scf-slide\" data-full=\"YOUR_FULL_SIZE_URL\">\n  <div class=\"scf-img-wrap\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0447/1017/files/DSC05349.png?v=1776713271\" alt=\"Photo 7\">\n\n  </div>\n  <div class=\"scf-caption\">O'neill Cold Water Classic</div>\n</div>\n<div class=\"scf-slide\" data-full=\"https://cdn.shopify.com/s/files/1/0447/1017/files/Storm_Surf_Shop_Polaroid.png?v=1776623662\">\n        <div class=\"scf-img-wrap\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0447/1017/files/DSC05593.png?v=1776712208\" alt=\"Photo 8\">\n        </div>\n        <div class=\"scf-caption\">John John Florence, 2009. We hear he's legal now, ladies.\".</div>\n      </div>\n\n<div class=\"scf-slide\" data-full=\"https://cdn.shopify.com/s/files/1/0447/1017/files/Storm_Surf_Shop_Polaroid.png?v=1776623662\">\n        <div class=\"scf-img-wrap\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0447/1017/files/IMG_0836_1024x1024.jpg?v=1495681232\" alt=\"Photo 9\">\n        </div>\n        <div class=\"scf-caption\">2 Decades of Stoke party. 2017.</div>\n\n</div>\n<div class=\"scf-slide\" data-full=\"https://cdn.shopify.com/s/files/1/0447/1017/files/Storm_Surf_Shop_Polaroid.png?v=1776623662\">\n        <div class=\"scf-img-wrap\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0447/1017/files/Screenshot_2023-04-10_at_14.15.12.png?v=1776711473\" alt=\"Photo 10\">\n        </div>\n        <div class=\"scf-caption\">Vans Duct Tape Festival. 2017.</div>\n\n    </div>\n<div class=\"scf-slide\" data-full=\"https://cdn.shopify.com/s/files/1/0447/1017/files/Storm_Surf_Shop_Polaroid.png?v=1776623662\">\n        <div class=\"scf-img-wrap\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0447/1017/files/Screenshot_2023-04-10_at_14.01.20.png?v=1776711474\" alt=\"Photo 5\">\n        </div>\n        <div class=\"scf-caption\">Storm get's a face lift! \"It's not a meth lab\". 2018.</div>\n\n    </div>\n\n<div class=\"scf-slide\" data-full=\"https://cdn.shopify.com/s/files/1/0447/1017/files/Storm_Surf_Shop_Polaroid.png?v=1776623662\">\n        <div class=\"scf-img-wrap\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0447/1017/files/Screenshot_2023-04-10_at_13.12.28.png?v=1776714250\" alt=\"Photo 11\">\n        </div>\n        <div class=\"scf-caption\">Our first Surf n Flea market. 2022.</div>\n\n    </div>\n\n  </div>\n</div>\n\n\n<div class=\"scf-lightbox\" id=\"scf-lightbox\">\n  <button class=\"scf-lb-close\" id=\"scf-lb-close\">&#215;</button>\n  <img src=\"\" alt=\"\">\n</div>\n\n<script>\n(function() {\n\n  var SPREAD          = 320;\n  var SCALE_STEP      = 0.13;\n  var OPACITY_STEP    = 0.22;\n  var STACK_COMPRESS  = 0.5;\n  var HOVER_THRESHOLD = 80;\n  var WHEEL_THRESHOLD = 60;\n\n  var stage   = document.getElementById('scf-stage');\n  var lb      = document.getElementById('scf-lightbox');\n  var lbImg   = lb.querySelector('img');\n  var lbClose = document.getElementById('scf-lb-close');\n  var slides  = Array.from(stage.querySelectorAll('.scf-slide'));\n  var total   = slides.length;\n  var current = 0;\n  var locked  = false;\n\n  function layout(idx) {\n    current = ((idx % total) + total) % total;\n    slides.forEach(function(slide, i) {\n      var offset = i - current;\n      if (offset >  total / 2) offset -= total;\n      if (offset < -total / 2) offset += total;\n\n      var abs  = Math.abs(offset);\n      var dir  = offset < 0 ? -1 : offset > 0 ? 1 : 0;\n      var xPos = offset === 0 ? 0 : dir * (SPREAD + (abs - 1) * SPREAD * STACK_COMPRESS);\n      var scale   = Math.max(0.25, 1 - abs * SCALE_STEP);\n      var opacity = Math.max(0.08, 1 - abs * OPACITY_STEP);\n      var rotY    = offset === 0 ? 0 : dir * Math.min(abs * 7, 38);\n\n      slide.style.transform = 'translateX(' + xPos + 'px) scale(' + scale + ') rotateY(' + rotY + 'deg)';\n      slide.style.opacity   = opacity;\n      slide.style.zIndex    = 100 - abs * 10;\n      slide.classList.toggle('is-active', offset === 0);\n    });\n  }\n\n  function advance(dir) {\n    if (locked) return;\n    locked = true;\n    layout(current + dir);\n    setTimeout(function() { locked = false; }, 600);\n  }\n\n  /* ── Wheel / trackpad two-finger swipe ── */\n  var wheelAccum = 0;\n  var wheelTimer = null;\n\n  stage.addEventListener('wheel', function(e) {\n    e.preventDefault();\n    clearTimeout(wheelTimer);\n    wheelAccum += e.deltaX || e.deltaY;\n    if (Math.abs(wheelAccum) >= WHEEL_THRESHOLD) {\n      advance(wheelAccum > 0 ? 1 : -1);\n      wheelAccum = 0;\n    }\n    wheelTimer = setTimeout(function() { wheelAccum = 0; }, 200);\n  }, { passive: false });\n\n  /* ── Mouse hover to navigate ── */\n  var lastX      = null;\n  var moveBuffer = 0;\n\n  stage.addEventListener('mousemove', function(e) {\n    if (lastX === null) { lastX = e.clientX; return; }\n    moveBuffer += e.clientX - lastX;\n    lastX = e.clientX;\n    if (moveBuffer > HOVER_THRESHOLD) {\n      advance(-1);\n      moveBuffer = 0;\n    } else if (moveBuffer < -HOVER_THRESHOLD) {\n      advance(1);\n      moveBuffer = 0;\n    }\n  });\n\n  stage.addEventListener('mouseleave', function() {\n    lastX = null;\n    moveBuffer = 0;\n  });\n\n  /* ── Touch swipe ── */\n  var touchStartX = 0;\n  var touchDelta  = 0;\n\n  stage.addEventListener('touchstart', function(e) {\n    touchStartX = e.touches[0].clientX;\n    touchDelta  = 0;\n  }, { passive: true });\n\n  stage.addEventListener('touchmove', function(e) {\n    touchDelta = e.touches[0].clientX - touchStartX;\n  }, { passive: true });\n\n  stage.addEventListener('touchend', function() {\n    if (Math.abs(touchDelta) > 40) {\n      advance(touchDelta < 0 ? 1 : -1);\n    }\n    touchDelta = 0;\n  });\n\n  /* ── Keyboard ── */\n  document.addEventListener('keydown', function(e) {\n    if (e.key === 'ArrowLeft')  advance(-1);\n    if (e.key === 'ArrowRight') advance(1);\n    if (e.key === 'Escape')     lb.classList.remove('active');\n  });\n\n  /* ── Lightbox ── */\n  slides.forEach(function(slide) {\n    slide.addEventListener('click', function() {\n      if (slide.classList.contains('is-active')) {\n        var src = slide.dataset.full;\n        if (src) { lbImg.src = src; lb.classList.add('active'); }\n      }\n    });\n  });\n\n  lbClose.addEventListener('click', function() { lb.classList.remove('active'); });\n  lb.addEventListener('click', function(e) { if (e.target === lb) lb.classList.remove('active'); });\n\n  layout(0);\n\n})();\n</script>",
