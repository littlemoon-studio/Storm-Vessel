{%- layout none -%}
{%- comment -%}
  Storm: tiny JSON list of products with their spec metafields. Used by the "Refine" chips on product pages.
  Request it with ?view=storm-json plus the normal filters, for example:
    /collections/all?view=storm-json&filter.p.m.custom.collection=Infiniti&filter.p.m.custom.fitt=Mens
  Not linked anywhere and not meant for visitors. See collection.storm-json-debug.liquid to list the real metafield keys.
{%- endcomment -%}
{%- paginate collection.products by 50 -%}
{"count":{{ collection.products_count }},"products":[
{%- for p in collection.products -%}
{"h":{{ p.handle | json }},"t":{{ p.title | json }},"u":{{ p.url | json }},"a":{{ p.available | json }},"v":{{ p.vendor | json }},"c":{{ p.metafields.custom.collection.value | json }},"f":{{ p.metafields.custom.fitt.value | json }},"g":{{ p.metafields.custom.category.value | json }},"th":{{ p.metafields.custom.thickness.value | json }},"en":{{ p.metafields.custom.entry.value | json }},"ho":{{ p.metafields.custom.wetsuit_type.value | json }},"bs":{{ p.metafields.custom.boot_style.value | json }},"gs":{{ p.metafields.custom.glove_style.value | json }}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]}
{%- endpaginate -%}
