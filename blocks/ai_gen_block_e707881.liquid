{% doc %}
  @prompt
    product vendor, display product's vendor name


{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .product-vendor-{{ ai_gen_id }} {
    display: block;
    margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px 0;
    text-align: {{ block.settings.text_alignment }};
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    color: {{ block.settings.text_color }};
    {% if block.settings.text_style == 'uppercase' %}
      text-transform: uppercase;
    {% elsif block.settings.text_style == 'lowercase' %}
      text-transform: lowercase;
    {% elsif block.settings.text_style == 'capitalize' %}
      text-transform: capitalize;
    {% endif %}
  }

  {% if block.settings.add_background %}
    .product-vendor-{{ ai_gen_id }} {
      background-color: {{ block.settings.background_color }};
      padding: {{ block.settings.padding }}px;
      border-radius: {{ block.settings.border_radius }}px;
    }
  {% endif %}

  {% if block.settings.add_border %}
    .product-vendor-{{ ai_gen_id }} {
      border: {{ block.settings.border_width }}px {{ block.settings.border_style }} {{ block.settings.border_color }};
      border-radius: {{ block.settings.border_radius }}px;
      padding: {{ block.settings.padding }}px;
    }
  {% endif %}

  {% if block.settings.link_to_vendor %}
    .product-vendor-link-{{ ai_gen_id }} {
      text-decoration: {{ block.settings.link_style }};
      color: {{ block.settings.text_color }};
    }
    
    .product-vendor-link-{{ ai_gen_id }}:hover {
      color: {{ block.settings.link_hover_color }};
    }
  {% endif %}
{% endstyle %}

{% if product.vendor != blank %}
  <div class="product-vendor-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    {% if block.settings.show_prefix %}
      <span class="product-vendor-prefix-{{ ai_gen_id }}">{{ block.settings.prefix_text }}</span>
    {% endif %}
    
    {% if block.settings.link_to_vendor %}
      <a href="{{ product.vendor | url_for_vendor }}" class="product-vendor-link-{{ ai_gen_id }}">
        {{ product.vendor }}
      </a>
    {% else %}
      {{ product.vendor }}
    {% endif %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Product Vendor",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_prefix",
      "label": "Show prefix",
      "default": false
    },
    {
      "type": "text",
      "id": "prefix_text",
      "label": "Prefix text",
      "default": "By: "
    },
    {
      "type": "checkbox",
      "id": "link_to_vendor",
      "label": "Link to vendor collection",
      "default": true
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "text_style",
      "label": "Text case",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "lowercase",
          "label": "Lowercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ],
      "default": "normal"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 14
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#6b7280"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Link Style"
    },
    {
      "type": "select",
      "id": "link_style",
      "label": "Text decoration",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "underline",
          "label": "Underline"
        }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Hover color",
      "default": "#4f46e5"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Top margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Bottom margin",
      "default": 10
    },
    {
      "type": "header",
      "content": "Decoration"
    },
    {
      "type": "checkbox",
      "id": "add_background",
      "label": "Add background",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f3f4f6"
    },
    {
      "type": "checkbox",
      "id": "add_border",
      "label": "Add border",
      "default": false
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "Border style",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "dashed",
          "label": "Dashed"
        },
        {
          "value": "dotted",
          "label": "Dotted"
        }
      ],
      "default": "solid"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "Border width",
      "default": 1
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#e5e7eb"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Border radius",
      "default": 4
    },
    {
      "type": "range",
      "id": "padding",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Padding",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Product Vendor"
    }
  ]
}
{% endschema %}