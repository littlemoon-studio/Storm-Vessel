{% doc %}
  @prompt
    Editable column section that has an image over top, and below is heading and body text
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-column-section-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-column-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-column-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.column_gap }}px;
    align-items: {{ block.settings.vertical_alignment }};
  }

  .ai-column-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-column-image-wrapper-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.image_spacing }}px;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-column-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-column-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-column-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-column-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    line-height: 1.2;
  }

  .ai-column-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.5;
    margin: 0;
  }

  .ai-column-text-{{ ai_gen_id }} p {
    margin: 0 0 1em;
  }

  .ai-column-text-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
  .ai-column-grid-{{ ai_gen_id }} {
    --slide: 50vw;          /* tweak card width */
    --gap: 12px;

    display: flex;
    gap: 60px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;

    /* keep edge alignment without clipping */
    margin: 0 -16px;        /* matches container side padding */
    padding: 0 16px;        /* restores inner space so first/last aren’t cut */
    scroll-padding-left: 16px;
    scroll-padding-right: 16px;
  }

  .ai-column-item-{{ ai_gen_id }} {
    flex: 0 0 var(--slide);
    scroll-snap-align: start;
    min-width: 0;           /* prevents inner overflow */
  }
  .ai-column-grid-{{ ai_gen_id }} {
  display: flex;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  gap: 16px;
  padding-left: 20px; /* keeps left alignment consistent with page */
  margin-right: -20px; /* lets right edge “bleed” offscreen */
}

.ai-column-item-{{ ai_gen_id }} {
  flex: 0 0 80%; /* adjust width of each card */
  scroll-snap-align: start;
}

}

  }
{% endstyle %}

<div class="ai-column-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-column-container-{{ ai_gen_id }}">
    <div class="ai-column-grid-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign column_enabled_key = 'column_' | append: i | append: '_enabled'
          assign column_image_key = 'column_' | append: i | append: '_image'
          assign column_heading_key = 'column_' | append: i | append: '_heading'
          assign column_text_key = 'column_' | append: i | append: '_text'

          assign column_enabled = block.settings[column_enabled_key]
          assign column_image = block.settings[column_image_key]
          assign column_heading = block.settings[column_heading_key]
          assign column_text = block.settings[column_text_key]
        %}

        {% if column_enabled %}
          <div class="ai-column-item-{{ ai_gen_id }}">
            <div class="ai-column-image-wrapper-{{ ai_gen_id }}">
              {% if column_image %}
                <img
                  src="{{ column_image | image_url: width: 600 }}"
                  alt="{{ column_image.alt | escape }}"
                  class="ai-column-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="{{ column_image.width }}"
                  height="{{ column_image.height }}"
                >
              {% else %}
                <div class="ai-column-image-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            {% if column_heading != blank %}
              <h3 class="ai-column-heading-{{ ai_gen_id }}">{{ column_heading }}</h3>
            {% endif %}

            {% if column_text != blank %}
              <div class="ai-column-text-{{ ai_gen_id }}">{{ column_text }}</div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

