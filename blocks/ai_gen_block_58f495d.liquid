{% doc %}
  @prompt
    Store Map section for Storm Surf Shop. Full-width custom-styled Google Maps JavaScript API map with hover info card.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-store-map-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .ai-store-map-container-{{ ai_gen_id }} {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    height: {{ block.settings.map_height }}px;
  }

  .ai-store-map-canvas-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
  }

  .ai-store-map-error-{{ ai_gen_id }} {
    display: none;
    width: 100%;
    height: 100%;
    background-color: #f5f5f5;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 40px 20px;
    color: #666;
    font-size: 14px;
  }

  .ai-store-map-error-{{ ai_gen_id }}.active {
    display: flex;
  }

  /* ── Info card ── */
  .ai-store-map-info-{{ ai_gen_id }} {
    position: absolute;
    {% if block.settings.card_position == 'bottom-left' %}
      bottom: 30px;
      left: 30px;
    {% else %}
      bottom: 30px;
      right: 30px;
    {% endif %}
    z-index: 20;
    background-color: {{ block.settings.card_bg_color }};
    color: {{ block.settings.card_text_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    width: 240px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .ai-store-map-container-{{ ai_gen_id }}:hover .ai-store-map-info-{{ ai_gen_id }} {
    opacity: 1;
    pointer-events: auto;
  }

  /* Always visible on mobile */
  @media screen and (max-width: 749px) {
    .ai-store-map-info-{{ ai_gen_id }} {
      opacity: 1;
      pointer-events: auto;
      bottom: 16px;
      left: 16px;
      right: auto;
      width: calc(100% - 32px);
    }
  }

  .ai-store-map-info-image-{{ ai_gen_id }} {
    width: 100%;
    height: 130px;
    object-fit: cover;
    display: block;
  }

  .ai-store-map-info-body-{{ ai_gen_id }} {
    padding: 14px 16px;
  }

  .ai-store-map-info-name-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 700;
    margin: 0 0 4px 0;
    color: {{ block.settings.card_text_color }};
  }

  .ai-store-map-info-address-{{ ai_gen_id }} {
    font-size: 12px;
    margin: 0 0 4px 0;
    color: {{ block.settings.card_text_color }};
    opacity: 0.75;
  }

  .ai-store-map-info-tagline-{{ ai_gen_id }} {
    font-size: 12px;
    margin: 0 0 10px 0;
    color: {{ block.settings.card_text_color }};
    opacity: 0.6;
  }

  .ai-store-map-info-link-{{ ai_gen_id }} {
    font-size: 12px;
    font-weight: 600;
    color: {{ block.settings.card_text_color }};
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
  }

  .ai-store-map-info-link-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }
{% endstyle %}

<store-map-{{ ai_gen_id }}
  class="ai-store-map-{{ ai_gen_id }}"
  data-api-key="{{ block.settings.google_maps_api_key }}"
  data-lat="{{ block.settings.latitude }}"
  data-lng="{{ block.settings.longitude }}"
  data-zoom="{{ block.settings.zoom_level }}"
  data-marker-url="{% if block.settings.custom_marker %}{{ block.settings.custom_marker | image_url: width: 200 }}{% endif %}"
  data-marker-width="{{ block.settings.marker_width }}"
  data-land-color="{{ block.settings.land_color }}"
  data-water-color="{{ block.settings.water_color }}"
  data-road-color="{{ block.settings.road_color }}"
  data-label-text-color="{{ block.settings.label_text_color }}"
  data-label-outline-color="{{ block.settings.label_outline_color }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-store-map-container-{{ ai_gen_id }}">

    <div id="ai-store-map-canvas-{{ ai_gen_id }}" class="ai-store-map-canvas-{{ ai_gen_id }}"></div>

    {%- comment -%} Clickable overlay — opens Google Maps directions {%- endcomment -%}
    <a href="https://www.google.com/maps/dir/?api=1&destination={{ block.settings.latitude }},{{ block.settings.longitude }}" target="_blank" style="position:absolute;inset:0;z-index:10;cursor:pointer;"></a>

    {%- comment -%} Hover info card {%- endcomment -%}
    <div class="ai-store-map-info-{{ ai_gen_id }}">
      {%- if block.settings.card_image != blank -%}
        <img
          src="{{ block.settings.card_image | image_url: width: 480 }}"
          alt="{{ block.settings.store_name | escape }}"
          class="ai-store-map-info-image-{{ ai_gen_id }}"
          loading="lazy"
        >
      {%- endif -%}
      <div class="ai-store-map-info-body-{{ ai_gen_id }}">
        {%- if block.settings.store_name != blank -%}
          <p class="ai-store-map-info-name-{{ ai_gen_id }}">{{ block.settings.store_name }}</p>
        {%- endif -%}
        {%- if block.settings.store_address != blank -%}
          <p class="ai-store-map-info-address-{{ ai_gen_id }}">{{ block.settings.store_address }}</p>
        {%- endif -%}
        {%- if block.settings.store_tagline != blank -%}
          <p class="ai-store-map-info-tagline-{{ ai_gen_id }}">{{ block.settings.store_tagline }}</p>
        {%- endif -%}
        <a
          href="https://www.google.com/maps/dir/?api=1&destination={{ block.settings.latitude }},{{ block.settings.longitude }}"
          target="_blank"
          class="ai-store-map-info-link-{{ ai_gen_id }}"
        >
          Get directions →
        </a>
      </div>
    </div>

    <div id="ai-store-map-error-{{ ai_gen_id }}" class="ai-store-map-error-{{ ai_gen_id }}">
      <div>
        <p>Unable to load map. Please check your Google Maps API key.</p>
      </div>
    </div>

  </div>
</store-map-{{ ai_gen_id }}>

<script>
  (function() {
    class StoreMap{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.apiKey = this.dataset.apiKey;
        this.lat = parseFloat(this.dataset.lat);
        this.lng = parseFloat(this.dataset.lng);
        this.zoom = parseInt(this.dataset.zoom);
        this.markerUrl = this.dataset.markerUrl;
        this.markerWidth = parseInt(this.dataset.markerWidth);
        this.landColor = this.dataset.landColor;
        this.waterColor = this.dataset.waterColor;
        this.roadColor = this.dataset.roadColor;
        this.labelTextColor = this.dataset.labelTextColor;
        this.labelOutlineColor = this.dataset.labelOutlineColor;
      }

      connectedCallback() {
        if (!this.apiKey) {
          this.showError();
          return;
        }

        if (window.google && window.google.maps) {
          this.initMap();
        } else {
          this.loadGoogleMapsAPI();
        }
      }

      loadGoogleMapsAPI() {
        if (document.querySelector('script[src*="maps.googleapis.com"]')) {
          const checkGoogleMaps = setInterval(() => {
            if (window.google && window.google.maps) {
              clearInterval(checkGoogleMaps);
              this.initMap();
            }
          }, 100);
          return;
        }

        const script = document.createElement('script');
        script.src = `https://maps.googleapis.com/maps/api/js?key=${this.apiKey}`;
        script.async = true;
        script.defer = true;
        script.onload = () => this.initMap();
        script.onerror = () => this.showError();
        document.head.appendChild(script);
      }

      initMap() {
        const mapCanvas = document.getElementById('ai-store-map-canvas-{{ ai_gen_id }}');

        if (!mapCanvas) {
          return;
        }

        const mapStyles = [
          {
            elementType: 'geometry',
            stylers: [{ color: this.landColor }]
          },
          {
            elementType: 'labels.text.fill',
            stylers: [{ color: this.labelTextColor }]
          },
          {
            elementType: 'labels.text.stroke',
            stylers: [{ color: this.labelOutlineColor }]
          },
          {
            featureType: 'water',
            elementType: 'geometry',
            stylers: [{ color: this.waterColor }]
          },
          {
            featureType: 'road',
            elementType: 'geometry',
            stylers: [{ color: this.roadColor }]
          },
          {
            featureType: 'road',
            elementType: 'geometry.stroke',
            stylers: [{ color: this.roadColor }]
          },
          {
            featureType: 'road.highway',
            elementType: 'geometry',
            stylers: [{ color: this.roadColor }]
          },
          {
            featureType: 'road.arterial',
            elementType: 'geometry',
            stylers: [{ color: this.roadColor }]
          },
          {
            featureType: 'poi',
            elementType: 'geometry',
            stylers: [{ color: this.landColor }]
          },
          {
            featureType: 'poi.park',
            elementType: 'geometry',
            stylers: [{ color: this.landColor }]
          },
          {
            featureType: 'transit',
            elementType: 'geometry',
            stylers: [{ color: this.roadColor }]
          },
          {
            featureType: 'poi',
            elementType: 'labels.icon',
            stylers: [{ visibility: 'off' }]
          },
          {
            featureType: 'transit',
            elementType: 'labels.icon',
            stylers: [{ visibility: 'off' }]
          }
        ];

        const mapOptions = {
          center: { lat: this.lat, lng: this.lng },
          zoom: this.zoom,
          styles: mapStyles,
          disableDefaultUI: true,
          zoomControl: false,
          mapTypeControl: false,
          scaleControl: false,
          streetViewControl: false,
          rotateControl: false,
          fullscreenControl: false
        };

        const map = new google.maps.Map(mapCanvas, mapOptions);

        const markerOptions = {
          position: { lat: this.lat, lng: this.lng },
          map: map
        };

        if (this.markerUrl) {
          const markerHeight = this.markerWidth;
          markerOptions.icon = {
            url: this.markerUrl,
            scaledSize: new google.maps.Size(this.markerWidth, markerHeight)
          };
        } else {
          markerOptions.icon = {
            path: google.maps.SymbolPath.CIRCLE,
            scale: 8,
            fillColor: this.labelTextColor,
            fillOpacity: 1,
            strokeColor: this.labelOutlineColor,
            strokeWeight: 2
          };
        }

        new google.maps.Marker(markerOptions);
      }

      showError() {
        const errorDiv = document.getElementById('ai-store-map-error-{{ ai_gen_id }}');
        if (errorDiv) {
          errorDiv.classList.add('active');
        }
      }
    }

    customElements.define('store-map-{{ ai_gen_id }}', StoreMap{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Store map",
  "tag": null,
  "class": "store-map-block",
  "settings": [
    {
      "type": "header",
      "content": "Google Maps API"
    },
    {
      "type": "text",
      "id": "google_maps_api_key",
      "label": "API key",
      "info": "Get your API key from Google Cloud Console"
    },
    {
      "type": "header",
      "content": "Location"
    },
    {
      "type": "text",
      "id": "latitude",
      "label": "Latitude",
      "default": "49.1527"
    },
    {
      "type": "text",
      "id": "longitude",
      "label": "Longitude",
      "default": "-125.9033"
    },
    {
      "type": "range",
      "id": "zoom_level",
      "label": "Zoom level",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 15
    },
    {
      "type": "header",
      "content": "Map dimensions"
    },
    {
      "type": "range",
      "id": "map_height",
      "label": "Height",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 550
    },
    {
      "type": "header",
      "content": "Marker"
    },
    {
      "type": "image_picker",
      "id": "custom_marker",
      "label": "Custom marker image"
    },
    {
      "type": "range",
      "id": "marker_width",
      "label": "Marker width",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Map colors"
    },
    {
      "type": "color",
      "id": "land_color",
      "label": "Land",
      "default": "#f9f8f6"
    },
    {
      "type": "color",
      "id": "water_color",
      "label": "Water",
      "default": "#e6e6e6"
    },
    {
      "type": "color",
      "id": "road_color",
      "label": "Roads",
      "default": "#d6d4d3"
    },
    {
      "type": "color",
      "id": "label_text_color",
      "label": "Label text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "label_outline_color",
      "label": "Label outline",
      "default": "#f9f8f6"
    },
    {
      "type": "header",
      "content": "Info card"
    },
    {
      "type": "image_picker",
      "id": "card_image",
      "label": "Card image"
    },
    {
      "type": "text",
      "id": "store_name",
      "label": "Store name",
      "default": "Storm Surf Shop"
    },
    {
      "type": "text",
      "id": "store_address",
      "label": "Address",
      "default": "444 Campbell St, Tofino BC"
    },
    {
      "type": "text",
      "id": "store_tagline",
      "label": "Tagline or hours",
      "default": "Open daily 9am – 6pm"
    },
    {
      "type": "select",
      "id": "card_position",
      "label": "Card position",
      "options": [
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "bottom-left"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Card text",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Store map"
    }
  ]
}
{% endschema %}
