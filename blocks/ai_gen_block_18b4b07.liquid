{% doc %}
  @prompt
    An interactive size chart table with 20 ROWS and 5 COLUMNS, And add a button on the top to switch the view from one table to another (the use will be to show imperial vs metric units).
    when the row or column is empty, it should be hidden. no radius on any of the containers. add padding in between between the imperial to metric buttons

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-size-chart-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;
  }

  /* Make entire first column bold */
.ai-size-chart-table-{{ ai_gen_id }} th:first-child,
.ai-size-chart-table-{{ ai_gen_id }} td:first-child {
  font-weight: 700;
}


  .ai-size-chart-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    margin-bottom: 20px;
    gap: 20px;
  }

  .ai-size-chart-toggle-{{ ai_gen_id }} {
    padding: 12px 24px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: 1px solid {{ block.settings.button_border_color }};
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    transition: all 0.2s ease;
    font: 'PT Mono';
    text-transform: uppercase;
  }

  .ai-size-chart-toggle-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-size-chart-toggle-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.button_active_background }};
    color: {{ block.settings.button_active_text_color }};
    border-color: {{ block.settings.button_active_border_color }};
  }

  .ai-size-chart-table-container-{{ ai_gen_id }} {
    width: 100%;
    overflow-x: auto;}

  .ai-size-chart-table-{{ ai_gen_id }} {
    width: 100%;
    border-collapse: collapse;
    background-color: {{ block.settings.table_background }};
    display: none;
  }

  .ai-size-chart-table-{{ ai_gen_id }}.active {
    display: table;
  }

  .ai-size-chart-table-{{ ai_gen_id }} th,
  .ai-size-chart-table-{{ ai_gen_id }} td {
    padding: {{ block.settings.cell_padding }}px;
    text-align: {{ block.settings.text_alignment }};
    border: 1px solid {{ block.settings.border_color }};
    border-left: none;
    border-right:none;
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
  }

  .ai-size-chart-table-{{ ai_gen_id }} th {
    background-color: {{ block.settings.header_background }};
    color: {{ block.settings.header_text_color }};
    font-weight: 600;
  }

  .ai-size-chart-table-{{ ai_gen_id }} tr:nth-child(even) td {
    background-color: {{ block.settings.row_alternate_background }};
  }

  .ai-size-chart-table-{{ ai_gen_id }} tr:hover td {
    background-color: {{ block.settings.row_hover_background }};
    color: #F9F8F6;
  }

  .ai-size-chart-table-{{ ai_gen_id }} .ai-size-chart-row-hidden-{{ ai_gen_id }} {
    display: none;
  }

  .ai-size-chart-table-{{ ai_gen_id }} .ai-size-chart-col-hidden-{{ ai_gen_id }} {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .ai-size-chart-header-{{ ai_gen_id }} {
      gap: 10px;
    }

    .ai-size-chart-toggle-{{ ai_gen_id }} {
      padding: 10px 16px;
      font-size: 12px;
    }

    .ai-size-chart-table-{{ ai_gen_id }} th,
    .ai-size-chart-table-{{ ai_gen_id }} td {
      padding: {{ block.settings.cell_padding | times: 0.7 }}px;
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<size-chart-{{ ai_gen_id }} class="ai-size-chart-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-size-chart-header-{{ ai_gen_id }}">
    <button 
      class="ai-size-chart-toggle-{{ ai_gen_id }} active" 
      data-table="imperial"
      aria-pressed="true"
    >
      {{ block.settings.imperial_label }}
    </button>
    <button 
      class="ai-size-chart-toggle-{{ ai_gen_id }}" 
      data-table="metric"
      aria-pressed="false"
    >
      {{ block.settings.metric_label }}
    </button>
  </div>

  <div class="ai-size-chart-table-container-{{ ai_gen_id }}">
    <table class="ai-size-chart-table-{{ ai_gen_id }} active" id="imperial-table-{{ ai_gen_id }}">
      <thead>
        <tr>
          {% for i in (1..5) %}
            {% assign header_key = 'imperial_header_' | append: i %}
            {% assign header_value = block.settings[header_key] %}
            {% if header_value != blank %}
              <th>{{ header_value }}</th>
            {% else %}
              <th class="ai-size-chart-col-hidden-{{ ai_gen_id }}"></th>
            {% endif %}
          {% endfor %}
        </tr>
      </thead>
      <tbody>
        {% for row in (1..20) %}
          {% assign has_content = false %}
          {% capture row_content %}
            {% for col in (1..5) %}
              {% assign cell_key = 'imperial_row_' | append: row | append: '_col_' | append: col %}
              {% assign cell_value = block.settings[cell_key] %}
              {% assign header_key = 'imperial_header_' | append: col %}
              {% assign header_value = block.settings[header_key] %}
              {% if cell_value != blank and header_value != blank %}
                {% assign has_content = true %}
                <td>{{ cell_value }}</td>
              {% elsif header_value != blank %}
                <td></td>
              {% else %}
                <td class="ai-size-chart-col-hidden-{{ ai_gen_id }}"></td>
              {% endif %}
            {% endfor %}
          {% endcapture %}
          {% if has_content %}
            <tr>{{ row_content }}</tr>
          {% endif %}
        {% endfor %}
      </tbody>
    </table>

    <table class="ai-size-chart-table-{{ ai_gen_id }}" id="metric-table-{{ ai_gen_id }}">
      <thead>
        <tr>
          {% for i in (1..5) %}
            {% assign header_key = 'metric_header_' | append: i %}
            {% assign header_value = block.settings[header_key] %}
            {% if header_value != blank %}
              <th>{{ header_value }}</th>
            {% else %}
              <th class="ai-size-chart-col-hidden-{{ ai_gen_id }}"></th>
            {% endif %}
          {% endfor %}
        </tr>
      </thead>
      <tbody>
        {% for row in (1..20) %}
          {% assign has_content = false %}
          {% capture row_content %}
            {% for col in (1..5) %}
              {% assign cell_key = 'metric_row_' | append: row | append: '_col_' | append: col %}
              {% assign cell_value = block.settings[cell_key] %}
              {% assign header_key = 'metric_header_' | append: col %}
              {% assign header_value = block.settings[header_key] %}
              {% if cell_value != blank and header_value != blank %}
                {% assign has_content = true %}
                <td>{{ cell_value }}</td>
              {% elsif header_value != blank %}
                <td></td>
              {% else %}
                <td class="ai-size-chart-col-hidden-{{ ai_gen_id }}"></td>
              {% endif %}
            {% endfor %}
          {% endcapture %}
          {% if has_content %}
            <tr>{{ row_content }}</tr>
          {% endif %}
        {% endfor %}
      </tbody>
    </table>
  </div>
</size-chart-{{ ai_gen_id }}>

<script>(function() {
    class SizeChart{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.toggleButtons = this.querySelectorAll('.ai-size-chart-toggle-{{ ai_gen_id }}');
        this.tables = this.querySelectorAll('.ai-size-chart-table-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.toggleButtons.forEach(button => {
          button.addEventListener('click', (e) => {
            const targetTable = e.target.dataset.table;
            this.switchTable(targetTable);
          });
        });
      }

      switchTable(targetTable) {
        this.toggleButtons.forEach(button => {
          const isActive = button.dataset.table === targetTable;
          button.classList.toggle('active', isActive);
          button.setAttribute('aria-pressed', isActive.toString());
        });

        this.tables.forEach(table => {
          const isTargetTable = table.id.includes(targetTable);
          table.classList.toggle('active', isTargetTable);
        });
      }
    }

    customElements.define('size-chart-{{ ai_gen_id }}', SizeChart{{ ai_gen_id }});
  })();
</script>

