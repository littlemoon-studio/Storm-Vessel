{% doc %}
  @prompt
    create a custom section that displays 4 collection links in one row (2 rows on mobile). the collection link is contained within a box, and all four boxes are equally spaces across the section and have a fixed width that the title must fit inside. No collection image, but add a border, background colour, and text colour to each box. , Also allow an open text box caption inside the collection box to add a custom caption/subheading. all text, including link title should be customizable for font, site, position, etc. and each box should be customizable for background colour and text colour, and need to have adjustments for top/bottom box padding within its section container, babe the caption should go above the collection title
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-collection-links-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;padding-top:{{ block.settings.section_padding_top }}px;padding-bottom:{{ block.settings.section_padding_bottom }}px;box-sizing:border-box}.ai-collection-links-{{ ai_gen_id }}__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:{{ block.settings.gap }}px;width:100%}.ai-collection-links-{{ ai_gen_id }}__link{display:flex;flex-direction:column;align-items:{{ block.settings.horizontal_position }};justify-content:{{ block.settings.vertical_position }};box-sizing:border-box;min-width:0;min-height:{{ block.settings.box_height }}px;padding:{{ block.settings.box_padding }}px;border:{{ block.settings.border_width }}px solid var(--box-border);border-radius:{{ block.settings.corner_radius }}px;background-color:var(--box-background);color:var(--box-text);text-align:{{ block.settings.text_alignment }};text-decoration:none;overflow-wrap:anywhere}.ai-collection-links-{{ ai_gen_id }}__title{margin:0;color:inherit;font-family:{{ block.settings.title_font.family }},{{ block.settings.title_font.fallback_families }};font-size:{{ block.settings.title_size }}px;font-weight:{{ block.settings.title_weight }};line-height:1.2}.ai-collection-links-{{ ai_gen_id }}__caption{margin:0 0 6px;color:inherit;font-family:{{ block.settings.caption_font.family }},{{ block.settings.caption_font.fallback_families }};font-size:{{ block.settings.caption_size }}px;font-weight:{{ block.settings.caption_weight }};line-height:1.35}.ai-collection-links-{{ ai_gen_id }}__link:focus-visible{outline:2px solid currentColor;outline-offset:3px}@media screen and (max-width:749px){.ai-collection-links-{{ ai_gen_id }}__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
{% endstyle %}
<div class="ai-collection-links-{{ ai_gen_id }}" {{ block.shopify_attributes }}><nav class="ai-collection-links-{{ ai_gen_id }}__grid" aria-label="Collections">{% for i in (1..4) %}{% liquid
assign collection_key = 'collection_' | append: i
assign caption_key = 'caption_' | append: i
assign background_key = 'background_' | append: i
assign text_key = 'text_color_' | append: i
assign border_key = 'border_color_' | append: i
assign selected_collection = block.settings[collection_key]
assign custom_caption = block.settings[caption_key]
%}{% if selected_collection != blank %}<a class="ai-collection-links-{{ ai_gen_id }}__link" href="{{ selected_collection.url }}" style="--box-background:{{ block.settings[background_key] }};--box-text:{{ block.settings[text_key] }};--box-border:{{ block.settings[border_key] }};">{% if custom_caption != blank %}<span class="ai-collection-links-{{ ai_gen_id }}__caption">{{ custom_caption | escape | newline_to_br }}</span>{% endif %}<span class="ai-collection-links-{{ ai_gen_id }}__title">{{ selected_collection.title | escape }}</span></a>{% endif %}{% endfor %}</nav></div>
{% schema %}
{"name":"Collection link row","settings":[{"type":"header","content":"Collections"},{"type":"collection","id":"collection_1","label":"Collection 1"},{"type":"textarea","id":"caption_1","label":"Caption 1"},{"type":"color","id":"background_1","label":"Background 1","default":"#F9F5EE"},{"type":"color","id":"text_color_1","label":"Text color 1","default":"#000000"},{"type":"color","id":"border_color_1","label":"Border color 1","default":"#000000"},{"type":"collection","id":"collection_2","label":"Collection 2"},{"type":"textarea","id":"caption_2","label":"Caption 2"},{"type":"color","id":"background_2","label":"Background 2","default":"#F9F5EE"},{"type":"color","id":"text_color_2","label":"Text color 2","default":"#000000"},{"type":"color","id":"border_color_2","label":"Border color 2","default":"#000000"},{"type":"collection","id":"collection_3","label":"Collection 3"},{"type":"textarea","id":"caption_3","label":"Caption 3"},{"type":"color","id":"background_3","label":"Background 3","default":"#F9F5EE"},{"type":"color","id":"text_color_3","label":"Text color 3","default":"#000000"},{"type":"color","id":"border_color_3","label":"Border color 3","default":"#000000"},{"type":"collection","id":"collection_4","label":"Collection 4"},{"type":"textarea","id":"caption_4","label":"Caption 4"},{"type":"color","id":"background_4","label":"Background 4","default":"#F9F5EE"},{"type":"color","id":"text_color_4","label":"Text color 4","default":"#000000"},{"type":"color","id":"border_color_4","label":"Border color 4","default":"#000000"},{"type":"header","content":"Layout and typography"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"section_padding_top","label":"Top section padding","min":0,"max":100,"step":5,"unit":"px","default":20},{"type":"range","id":"section_padding_bottom","label":"Bottom section padding","min":0,"max":100,"step":5,"unit":"px","default":20},{"type":"range","id":"box_height","label":"Minimum box height","min":60,"max":200,"step":10,"unit":"px","default":90},{"type":"range","id":"gap","label":"Space between boxes","min":0,"max":40,"step":2,"unit":"px","default":12},{"type":"range","id":"box_padding","label":"Box padding","min":4,"max":32,"step":2,"unit":"px","default":12},{"type":"range","id":"border_width","label":"Border width","min":0,"max":6,"step":1,"unit":"px","default":1},{"type":"range","id":"corner_radius","label":"Corner radius","min":0,"max":20,"step":1,"unit":"px","default":0},{"type":"select","id":"horizontal_position","label":"Horizontal position","options":[{"value":"flex-start","label":"Left"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Right"}],"default":"center"},{"type":"select","id":"vertical_position","label":"Vertical position","options":[{"value":"flex-start","label":"Top"},{"value":"center","label":"Center"},{"value":"flex-end","label":"Bottom"}],"default":"center"},{"type":"select","id":"text_alignment","label":"Text alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"center"},{"type":"font_picker","id":"title_font","label":"Title font","default":"pt_mono_n4"},{"type":"range","id":"title_size","label":"Title size","min":12,"max":32,"step":1,"unit":"px","default":18},{"type":"select","id":"title_weight","label":"Title weight","options":[{"value":"400","label":"Regular"},{"value":"500","label":"Medium"},{"value":"600","label":"Semibold"},{"value":"700","label":"Bold"}],"default":"700"},{"type":"font_picker","id":"caption_font","label":"Caption font","default":"work_sans_n4"},{"type":"range","id":"caption_size","label":"Caption size","min":10,"max":20,"step":1,"unit":"px","default":13},{"type":"select","id":"caption_weight","label":"Caption weight","options":[{"value":"400","label":"Regular"},{"value":"500","label":"Medium"},{"value":"600","label":"Semibold"},{"value":"700","label":"Bold"}],"default":"400"}],"presets":[{"name":"Collection link row"}],"tag":null,"class":"collection-link-row"}
