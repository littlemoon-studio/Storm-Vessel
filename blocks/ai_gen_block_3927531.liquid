  }

  .ai-staff-pick-overlay-{{ ai_gen_id }}[data-staff="allister"] .ai-staff-pick-heading-{{ ai_gen_id }},
  .ai-staff-pick-overlay-{{ ai_gen_id }}[data-staff="allister"] .ai-staff-pick-body-{{ ai_gen_id }} {
    color: {{ block.settings.allister_text_color }};
  }
{% endstyle %}

<staff-pick-overlay-{{ ai_gen_id }} class="ai-staff-pick-wrapper-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <slot></slot>

  {% liquid
    assign staff_member = ''
    assign staff_heading = ''
    assign staff_body = ''
    
    if product.tags contains 'benpick'
      assign staff_member = 'ben'
      assign staff_heading = block.settings.ben_heading
      assign staff_body = block.settings.ben_body
    elsif product.tags contains 'chrispick'
      assign staff_member = 'chris'
      assign staff_heading = block.settings.chris_heading
      assign staff_body = block.settings.chris_body
    elsif product.tags contains 'amandapick'
      assign staff_member = 'amanda'
      assign staff_heading = block.settings.amanda_heading
      assign staff_body = block.settings.amanda_body
    elsif product.tags contains 'ronpick'
      assign staff_member = 'ron'
      assign staff_heading = block.settings.ron_heading
      assign staff_body = block.settings.ron_body
    elsif product.tags contains 'craigpick'
      assign staff_member = 'craig'
      assign staff_heading = block.settings.craig_heading
      assign staff_body = block.settings.craig_body
    elsif product.tags contains 'nicpick'
      assign staff_member = 'nic'
      assign staff_heading = block.settings.nic_heading
      assign staff_body = block.settings.nic_body
    elsif product.tags contains 'lilypick'
      assign staff_member = 'lily'
      assign staff_heading = block.settings.lily_heading
      assign staff_body = block.settings.lily_body
    elsif product.tags contains 'jenpick'
      assign staff_member = 'jen'
      assign staff_heading = block.settings.jen_heading
      assign staff_body = block.settings.jen_body
    elsif product.tags contains 'allisterpick'
      assign staff_member = 'allister'
      assign staff_heading = block.settings.allister_heading
      assign staff_body = block.settings.allister_body
    endif
  %}

  {% if staff_member != '' %}
    <div class="ai-staff-pick-overlay-{{ ai_gen_id }}" data-staff="{{ staff_member }}">
      <div class="ai-staff-pick-content-{{ ai_gen_id }}">
        {% if staff_heading != blank %}
          <p class="ai-staff-pick-heading-{{ ai_gen_id }}">{{ staff_heading }}</p>
        {% endif %}
        {% if staff_body != blank %}
          <p class="ai-staff-pick-body-{{ ai_gen_id }}">{{ staff_body }}</p>
        {% endif %}
      </div>
    </div>
  {% endif %}
</staff-pick-overlay-{{ ai_gen_id }}>

<script>
  (function() {
    class StaffPickOverlay{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const overlay = this.querySelector('.ai-staff-pick-overlay-{{ ai_gen_id }}');
        if (overlay) {
          this.addEventListener('mouseenter', () => {
            overlay.style.opacity = '1';
            overlay.style.visibility = 'visible';
          });

          this.addEventListener('mouseleave', () => {
            overlay.style.opacity = '0';
            overlay.style.visibility = 'hidden';
          });
        }
      }
    }

    customElements.define('staff-pick-overlay-{{ ai_gen_id }}', StaffPickOverlay{{ ai_gen_id }});
  })();
</script>

