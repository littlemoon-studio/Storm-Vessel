  .ai-staff-pick-overlay-{{ ai_gen_id }}[data-staff="amanda"] .ai-staff-pick-heading-{{ ai_gen_id }},
  .ai-staff-pick-overlay-{{ ai_gen_id }}[data-staff="amanda"] .ai-staff-pick-body-{{ ai_gen_id }} {
    color: {{ block.settings.amanda_text_color }};
  }

  .ai-staff-pick-overlay-{{ ai_gen_id }}[data-staff="ron"] {
    background-color: {{ block.settings.ron_color }};
  }

  .ai-staff-pick-overlay-{{ ai_gen_id }}[data-staff="ron"] .ai-staff-pick-heading-{{ ai_gen_id }},
  .ai-staff-pick-overlay-{{ ai_gen_id }}[data-staff="ron"] .ai-staff-pick-body-{{ ai_gen_id }} {
