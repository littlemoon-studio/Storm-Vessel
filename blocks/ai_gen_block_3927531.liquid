  }

  .ai-staff-pick-overlay-{{ ai_gen_id }}[data-staff="craig"] {
    background-color: {{ block.settings.craig_color }};
  }

  .ai-staff-pick-overlay-{{ ai_gen_id }}[data-staff="craig"] .ai-staff-pick-heading-{{ ai_gen_id }},
