{% doc %}
  @prompt
    Create a custom hover effect for product cards in collection pages that displays staff pick overlays based on product tags. When a product is tagged with staff identifiers like 'benpick', 'sarahpick', etc., hovering over the product card should show a semi-transparent colored overlay with text like "Ben's Pick" or "Sarah's Pick". Each staff member should have their own distinct overlay color (e.g., green for Ben, blue for Sarah). The overlay should appear smoothly on hover and include the staff member's name prominently displayed. The code should check for product tags and apply the appropriate styling dynamically., I don't want the default to include the names Sarah, mike, Emma and Alex. only include: Ben, Chris, Amanda, Ron, Craig, Nic, Lily, Jen, and Allister. they should correspond with products with the tag format: benpick, chrispick, amandapick, etc etc. And to be able to edit text within the theme editor controls. it should have a heading, and a body both with editable text, I don't want the default to include the names Sarah, mike, Emma and Alex. only include: Ben, Chris, Amanda, Ron, Craig, Nic, Lily, Jen, and Allister. they should correspond with products with the tag format: benpick, chrispick, amandapick, etc etc. And to be able to edit text within the theme editor controls. it should have a heading, and a body both with editable text
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-staff-pick-wrapper-{{ ai_gen_id }} {
    position: relative;
    display: block;
    width: 100%;
  }

  .ai-staff-pick-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity {{ block.settings.transition_speed }}ms ease, visibility {{ block.settings.transition_speed }}ms ease;
    pointer-events: none;
    z-index: 10;
  }

  .ai-staff-pick-wrapper-{{ ai_gen_id }}:hover .ai-staff-pick-overlay-{{ ai_gen_id }} {
    opacity: 1;
    visibility: visible;
  }

  .ai-staff-pick-content-{{ ai_gen_id }} {
    text-align: center;
    padding: 20px;
  }

  .ai-staff-pick-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    text-transform: {{ block.settings.heading_transform }};
    margin: 0 0 8px 0;
  }

  .ai-staff-pick-body-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_size }}px;
    font-weight: {{ block.settings.body_weight }};
    margin: 0;
  }

  .ai-staff-pick-overlay-{{ ai_gen_id }}[data-staff="ben"] {
    background-color: {{ block.settings.ben_color }};
  }

  .ai-staff-pick-overlay-{{ ai_gen_id }}[data-staff="ben"] .ai-staff-pick-heading-{{ ai_gen_id }},
  .ai-staff-pick-overlay-{{ ai_gen_id }}[data-staff="ben"] .ai-staff-pick-body-{{ ai_gen_id }} {
    color: {{ block.settings.ben_text_color }};
  }

  .ai-staff-pick-overlay-{{ ai_gen_id }}[data-staff="chris"] {
    background-color: {{ block.settings.chris_color }};
  }

  .ai-staff-pick-overlay-{{ ai_gen_id }}[data-staff="chris"] .ai-staff-pick-heading-{{ ai_gen_id }},
  .ai-staff-pick-overlay-{{ ai_gen_id }}[data-staff="chris"] .ai-staff-pick-body-{{ ai_gen_id }} {
    color: {{ block.settings.chris_text_color }};
  }

