{%- comment -%}
  Storm: swatch background from a colour NAME, using the colour list in Theme settings → Storm swatch colours.
  Prints a CSS value, or nothing when the name is not a colour we know.
    - "Black/Red", "Black & Red", "Black + Red" → half-and-half gradient (needs both words in the list)
    - "Matte Black/Gray Green Polar" → the first colour alone when the rest is not a colour
    - "Navy" → that colour
    - a list line can name a whole value: "black/red = #111111 #A90707" (two codes = split)
  This lets swatches work without linking Shopify swatch entries. Image swatches are never touched.

  @param {string} name - the colour option value
{%- endcomment -%}
{%- liquid
  assign storm_css = ''
  assign dict = '<br />' | append: settings.storm_swatch_colours | downcase | newline_to_br | strip_newlines | replace: ' = ', '=' | replace: ' =', '=' | replace: '= ', '='
  assign wanted = name | downcase | strip | replace: ' & ', '/' | replace: ' + ', '/' | replace: ' and ', '/' | replace: ' / ', '/' | replace: ' - ', '/'
  assign marker = '<br />' | append: wanted | append: '='
  assign hit = dict | split: marker
  if hit.size > 1
    assign val = hit[1] | split: '<br />' | first | strip
    if val contains ' '
      assign two = val | split: ' '
      if two.size > 2
        assign storm_css = 'linear-gradient(135deg, ' | append: two[0] | append: ' 0 33.33%, ' | append: two[1] | append: ' 33.33% 66.66%, ' | append: two[2] | append: ' 66.66% 100%)'
      else
        assign storm_css = 'linear-gradient(135deg, ' | append: two[0] | append: ' 0 50%, ' | append: two[1] | append: ' 50% 100%)'
      endif
    else
      assign storm_css = val
    endif
  elsif wanted contains '/'
    assign parts = wanted | split: '/'
    assign marker_a = '<br />' | append: parts[0] | strip | append: '='
    assign marker_b = '<br />' | append: parts[1] | strip | append: '='
    assign hit_a = dict | split: marker_a
    assign hit_b = dict | split: marker_b
    assign hex_a = ''
    assign hex_b = ''
    if hit_a.size > 1
      assign hex_a = hit_a[1] | split: '<br />' | first | strip | split: ' ' | first
    endif
    if hit_b.size > 1
      assign hex_b = hit_b[1] | split: '<br />' | first | strip | split: ' ' | first
    endif
    if hex_a != '' and hex_b != ''
      assign storm_css = 'linear-gradient(135deg, ' | append: hex_a | append: ' 0 50%, ' | append: hex_b | append: ' 50% 100%)'
    elsif hex_a != ''
      assign storm_css = hex_a
    endif
  endif
-%}
{{- storm_css -}}
