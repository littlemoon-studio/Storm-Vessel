{%- comment -%}
  Storm product card. Swatches show only when the product has 2+ swatch values (e.g. Colour).
  Usage: {% render 'storm-product-card', product: product, flush: true, photo_mode: 'flat' %}  (photo_mode: first | flat | model | photo_2 | photo_3 | photo_4)
{%- endcomment -%}
{%- liquid
  assign colour_option = nil
  for option in product.options_with_values
    capture storm_swatch_count_text
      render 'storm-swatch-count', option: option
    endcapture
    assign swatch_count = storm_swatch_count_text | plus: 0
    if swatch_count > 1
      assign colour_option = option
      break
    endif
  endfor
-%}
{%- liquid
  assign card_media = product.featured_media
  if photo_mode != blank and photo_mode != 'first'
    capture photo_index
      render 'storm-card-photo-index', product: product, mode: photo_mode
    endcapture
    assign photo_index = photo_index | strip | plus: 0
    if photo_index >= 0
      assign card_media = product.media[photo_index]
    endif
  endif
-%}
<a href="{{ product.url }}" class="storm-card{% if flush %} storm-card--flush{% endif %}">
  <div class="storm-card__media">
    {%- if card_media -%}
      {{ card_media | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 450, 600, 900', sizes: '(min-width: 900px) 25vw, 50vw', alt: card_media.alt }}
    {%- else -%}
      {{ 'product-apparel-1' | placeholder_svg_tag }}
    {%- endif -%}
  </div>
  <div class="storm-card__info">
    <span class="storm-card__title">{{ product.title | escape }}</span>
    <span class="storm-card__vendor">{{ product.vendor | escape }}</span>
    <div class="storm-card__bottom">
      <span class="storm-card__price">{% if product.price_varies %}From {% endif %}{{ product.price | money_with_currency }}</span>
      {%- if colour_option -%}
        <span class="storm-card__swatches">
          {%- for value in colour_option.values limit: 4 -%}
            {%- if value.swatch.image -%}
              <span class="storm-card__swatch" style="background-image: url({{ value.swatch.image | image_url: width: 24 }});" title="{{ value | escape }}"></span>
            {%- else -%}
              {%- capture storm_split -%}{% render 'storm-swatch-split', name: value.name %}{%- endcapture -%}
              {%- assign storm_split = storm_split | strip -%}
              {%- liquid
                if storm_split contains 'linear-gradient'
                  assign card_swatch_bg = storm_split
                elsif value.swatch.color
                  assign card_swatch_bg = value.swatch.color
                elsif storm_split != blank
                  assign card_swatch_bg = storm_split
                else
                  assign card_swatch_bg = 'repeating-linear-gradient(45deg, #E6E0D4 0 3px, #D4CCBC 3px 6px)'
                endif
              -%}
              <span class="storm-card__swatch" style="background: {{ card_swatch_bg }};" title="{{ value | escape }}"></span>
            {%- endif -%}
          {%- endfor -%}
          {%- if colour_option.values.size > 4 -%}<span class="storm-card__more">+{{ colour_option.values.size | minus: 4 }}</span>{%- endif -%}
        </span>
      {%- endif -%}
    </div>
  </div>
</a>
