{%- comment -%}
  Storm: optional falling "snow" over the page, drawn in Storm reds and sand so it reads on cream.
  Off by default. Turn on in Theme settings → Storm holiday messaging. It turns itself off after the end date.
  Safeguards: skipped for visitors who ask for reduced motion, on low-power devices, and when the tab is hidden.
  One small canvas, no libraries, ignores clicks (pointer-events: none).
{%- endcomment -%}
{%- liquid
  assign snow_on = false
  if settings.storm_snow_enabled
    assign snow_on = true
    if settings.storm_snow_until != blank
      assign snow_end = settings.storm_snow_until | date: '%s' | plus: 86400
      assign snow_now = 'now' | date: '%s' | plus: 0
      if snow_now >= snow_end
        assign snow_on = false
      endif
    endif
  endif
-%}
{%- if snow_on -%}
  <canvas id="storm-snow" aria-hidden="true" style="position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:4;"></canvas>
  <script>
    (() => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if ((navigator.hardwareConcurrency || 8) <= 4 || (navigator.connection && navigator.connection.saveData)) return;
      const canvas = document.getElementById('storm-snow');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      const colours = ['rgba(169,7,7,0.55)', 'rgba(230,46,9,0.5)', 'rgba(246,231,210,0.9)', 'rgba(100,4,3,0.45)'];
      let w = 0, h = 0, flakes = [], raf = null, last = 0;
      const resize = () => {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        w = window.innerWidth; h = window.innerHeight;
        canvas.width = w * dpr; canvas.height = h * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        const count = Math.min(60, Math.round(w / 24));
        flakes = Array.from({ length: count }, () => ({
          x: Math.random() * w, y: Math.random() * h,
          r: 1.5 + Math.random() * 2.5, s: 18 + Math.random() * 34,
          d: Math.random() * Math.PI * 2, c: colours[(Math.random() * colours.length) | 0],
        }));
      };
      const draw = (now) => {
        const dt = Math.min(0.05, (now - last) / 1000 || 0.016); last = now;
        ctx.clearRect(0, 0, w, h);
        for (const f of flakes) {
          f.y += f.s * dt; f.d += dt; f.x += Math.sin(f.d) * 14 * dt;
          if (f.y > h + 6) { f.y = -6; f.x = Math.random() * w; }
          ctx.beginPath(); ctx.fillStyle = f.c; ctx.arc(f.x, f.y, f.r, 0, 6.2832); ctx.fill();
        }
        raf = requestAnimationFrame(draw);
      };
      const start = () => { if (!raf) { last = performance.now(); raf = requestAnimationFrame(draw); } };
      const stop = () => { if (raf) { cancelAnimationFrame(raf); raf = null; } };
      document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
      window.addEventListener('resize', resize, { passive: true });
      resize(); start();
    })();
  </script>
{%- endif -%}
